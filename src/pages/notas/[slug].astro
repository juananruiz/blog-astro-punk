---
import { render } from 'astro:content';
import NotaLayout from '../../layouts/NotaLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getNotasPublicas, fechaLegible } from '../../lib/notas';

export async function getStaticPaths() {
  const notas = await getNotasPublicas();
  return notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);

const etiquetas = nota.data.tags.join(' · ');
const fecha = fechaLegible(nota);

// `nota.data.image` NO se pinta: en el vault es un embed de Obsidian
// ("![[foo.png|150]]"), no una URL servible. Haría falta copiar los adjuntos a
// /public y reescribir la referencia.
---

<NotaLayout title={`${nota.data.title} — Juanan Ruiz`}>
  <Header current="notas" searchPlaceholder="Buscar y pulsa Enter…" />
  <main class="wrap">
    <div class="article-head">
      <div class="meta">
        <span>Nota</span>
        {etiquetas && <><span class="sep"> · </span><span>{etiquetas}</span></>}
        {fecha && <><span class="sep"> · </span><span class="date">{fecha}</span></>}
      </div>
      <h1>{nota.data.title}</h1>
      {nota.data.description && <p class="dek">{nota.data.description}</p>}
    </div>
    <article class="article-body"><Content /></article>
    <div class="article-fleuron"><img src="/img/fleuron-horizontal-steampunk.png" alt="" /></div>
    <p class="nota-volver"><a href="/notas">← Todas las notas</a></p>
    <div class="author-row">
      <div class="avatar"><img src="/img/juanan-steampunk.jpg" alt="Juanan Ruiz" /></div>
      <div>
        <p class="name">Juanan Ruiz</p>
        <p class="tagline">Notas del cuaderno, sin pulir.</p>
      </div>
    </div>
  </main>
  <Footer />
</NotaLayout>

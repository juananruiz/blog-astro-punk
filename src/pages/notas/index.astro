---
import NotaLayout from '../../layouts/NotaLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getNotasPublicas, fechaLegible } from '../../lib/notas';

// `data-post`, `data-title` y `data-excerpt` son los que lee el buscador de
// public/js/main.js. Sin chips de categoría el filtro se queda en "todos", así
// que la búsqueda funciona aquí sin tocar el JS.
const notas = (await getNotasPublicas()).map((nota) => ({
  id: nota.id,
  title: nota.data.title,
  description: nota.data.description ?? '',
  etiquetas: nota.data.tags.join(' · '),
  fecha: fechaLegible(nota),
}));
---

<NotaLayout title="Notas — Juanan Ruiz">
  <Header current="notas" searchPlaceholder="Buscar en las notas…" />
  <main class="wrap">
    <div class="intro">
      <p>Notas sueltas de mi cuaderno personal, publicadas tal cual las escribo.</p>
    </div>
    <div class="hr"></div>
    <section class="post-list">
      {notas.map((nota) => (
        <article class="post-item" data-post data-title={nota.title} data-excerpt={nota.description}>
          <div class="meta">
            <span>Nota</span>
            {nota.etiquetas && <><span class="sep"> · </span><span>{nota.etiquetas}</span></>}
            {nota.fecha && <><span class="sep"> · </span><span class="date">{nota.fecha}</span></>}
          </div>
          <h2><a href={`/notas/${nota.id}`}>{nota.title}</a></h2>
          {nota.description && <p class="excerpt">{nota.description}</p>}
        </article>
      ))}
      <p class="no-results" data-no-results style="display:none">No se encontraron notas con ese filtro.</p>
      {notas.length === 0 && <p class="no-results">Todavía no hay notas publicadas.</p>}
    </section>
  </main>
  <Footer />
</NotaLayout>

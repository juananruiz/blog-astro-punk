---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const posts = (await getCollection("posts")).sort((a, b) => {
	if (a.data.order !== undefined && b.data.order !== undefined) {
		return a.data.order - b.data.order;
	}
	if (a.data.order !== undefined) return -1;
	if (b.data.order !== undefined) return 1;
	return b.data.date.getTime() - a.data.date.getTime();
});

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
	(post.data.tags ?? []).forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	});
});
const counts = [...tagCounts.values()];
const minCount = counts.length ? Math.min(...counts) : 0;
const maxCount = counts.length ? Math.max(...counts) : 0;
function tagLevel(count: number) {
	if (maxCount === minCount) return 3;
	return 1 + Math.round(((count - minCount) / (maxCount - minCount)) * 3);
}
const tagCloud = [...tagCounts.entries()]
	.sort((a, b) => a[0].localeCompare(b[0], "es"))
	.map(([tag, count]) => ({ tag, count, level: tagLevel(count) }));
---

<BaseLayout title="Juanan Ruiz — Blog personal">
	<Header current="home" searchPlaceholder="Buscar en el blog…" />
	<main class="wrap-wide home-layout">
		<aside class="profile-card">
			<div class="avatar-xl">
				<img src="/img/juanan-steampunk.jpg" alt="Juanan Ruiz" />
			</div>
			<div class="profile-body">
				<p class="profile-name">Juanan Ruiz</p>
				<p class="profile-handle">Aprendiz a tiempo completo.</p>
				<p class="profile-bio">
					Aprendiz de programador en mis ratos libres. Desarrollo web
					con PHP, Symfony, SQL y JavaScript. Pinitos IA en Python,
					Node, etc.
				</p>
				<ul class="profile-meta">
					<li>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							><path
								d="M3 21h18M5 21V5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v16M14 9h4a1 1 0 0 1 1 1v11M8 8h3M8 12h3M8 16h3"
							></path></svg
						><span>Universidad de Sevilla</span>
					</li>
					<li>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							><path
								d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"
							></path><circle cx="12" cy="10" r="3"></circle></svg
						><span>Sevilla, España</span>
					</li>
					<li>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							stroke="none"
							aria-hidden="true"
							><path
								d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"
							></path></svg
						><a href="https://github.com/juananruiz"
							>github.com/juananruiz</a>
					</li>
				</ul>
			</div>
			{tagCloud.length > 0 && (
				<div class="tag-cloud-block">
					<p class="tag-cloud-title">Tags</p>
					<div class="tag-cloud" aria-label="Nube de tags">
						{tagCloud.map(({ tag, count, level }) => (
							<button
								type="button"
								class="tag-pill"
								data-tag-chip={tag}
								data-level={level}
								title={`${count} artículo${count === 1 ? "" : "s"}`}
							>
								{tag}
							</button>
						))}
					</div>
				</div>
			)}
		</aside>
		<div class="home-main">
			<div class="intro">
				<p>Apuntes sobre código, ideas y el arte de construir cosas.</p>
			</div>
			<div
				class="filters"
				role="group"
				aria-label="Filtrar por categoría"
			>
				<button
					class="chip active"
					data-category-chip="todos"
					type="button">Todos</button
				><button
					class="chip"
					data-category-chip="programacion"
					type="button">Programación</button
				><button
					class="chip"
					data-category-chip="reflexiones"
					type="button">Reflexiones</button
				><button
					class="chip"
					data-category-chip="proyectos"
					type="button">Proyectos</button
				><button
					class="chip"
					data-category-chip="lecturas"
					type="button">Lecturas</button
				><button class="chip" data-category-chip="ia" type="button"
					>IA</button
				>
			</div>
			<div class="hr"></div>
			<section class="post-list">
				{
					posts.map((post) => (
						<article
							class:list={[
								"post-item",
								{ featured: post.data.featured },
							]}
							data-post
							data-category={post.data.category}
							data-tags={(post.data.tags ?? []).join(",")}
							data-title={
								post.data.searchTitle ?? post.data.title
							}
							data-excerpt={post.data.description}
						>
							{post.data.featured && post.data.image && (
								<div class="thumb">
									<div class="plate">
										<img
											src={post.data.image}
											alt={post.data.imageAlt}
										/>
									</div>
								</div>
							)}
							<div
								class={post.data.featured ? "body" : undefined}
							>
								<div class="meta">
									<>
										<span>{post.data.categoryLabel}</span>
										<span class="sep">·</span>
										<span class="date">
											{post.data.dateLabel}
										</span>
									</>
								</div>
								<h2>
									<a href={`/posts/${post.id}`}>
										{post.data.title}
									</a>
								</h2>
								<p class="excerpt">{post.data.description}</p>
							</div>
						</article>
					))
				}
				<p class="no-results" data-no-results style="display:none">
					No se encontraron artículos con ese filtro.
				</p>
			</section>
		</div>
	</main>
	<Footer />
</BaseLayout>

---
interface Props { current?: 'home' | 'post' | 'notas'; searchPlaceholder: string }
const { current, searchPlaceholder } = Astro.props;
---

<header class="site-header" id="top">
  <a class="brand-link" href="/">
    <img src="/img/logo-blog-steampunk.png" alt="logo del blog rueda dentada con signos </> estilo steampunk" width="75" />
    <span>Juanan Ruiz</span>
  </a>
  <nav class="main-nav">
    <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Inicio</a>
    <a href="/notas" aria-current={current === 'notas' ? 'page' : undefined}>Notas</a>
    <a href="#">Archivo</a>
    <a href="#">Sobre mí</a>
  </nav>
  <div class="header-tools">
    <div class="header-divider"></div>
    <button class="icon-btn" data-search-toggle type="button" aria-label="Buscar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </button>
    <button class="theme-toggle" data-theme-toggle type="button" aria-label="Cambiar tema claro/oscuro"></button>
  </div>
</header>

<div class="search-box" data-search-box>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color:var(--color-neutral-500);flex:none"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
  <input type="text" data-search-input placeholder={searchPlaceholder} aria-label="Buscar artículos" />
</div>

---
/**
 * Layout de las notas del vault.
 *
 * Es una copia deliberada de BaseLayout, no una extensión: las notas y los
 * artículos van a divergir (metadatos distintos, quizá otra tipografía o
 * cabecera propia). Tenerlo separado permite cambiar el aspecto de las notas
 * sin tocar el blog. Si al final no divergen, se puede volver a BaseLayout.
 */
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/img/favicon.png" />
  </head>
  <body>
    <slot />
    <script src="/js/main.js" defer></script>
  </body>
</html>
